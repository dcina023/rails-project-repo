<section class="hero">
  <div>
    <h1>Plan your next little adventure</h1>
    <p>Choose a vibe, set a budget, and let your itinerary come together with places that feel like your kind of day.</p>
  </div>

  <div class="adventure-grid">
    <%= image_tag "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=900&q=80",
      alt: "People enjoying an outdoor adventure",
      class: "adventure-image" %>

    <%= image_tag "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=900&q=80",
      alt: "Scenic beach adventure",
      class: "adventure-image" %>
  </div>
</section>

<h1>Log In</h1>

<% if flash.now[:alert] %>
  <p class="error"><%= flash.now[:alert] %></p>
<% end %>

<%= form_with url: login_path do |form| %>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email, value: params[:email] %>
  </div>

  <div>
    <%= form.label :password %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.submit "Log In" %>
  </div>
<% end %>


