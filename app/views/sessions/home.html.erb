<h1>Log In</h1>

<% if flash.now[:alert] %>
  <p class="error"><%= flash.now[:alert] %></p>
<% end %>

<%= form_with url: login_path do |form| %>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email, value: params[:email] %>
  </div>

  <div>
    <%= form.label :password %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.submit "Log In" %>
  </div>
<% end %>

<%= link_to "Create an account", new_sign_up_path %>

