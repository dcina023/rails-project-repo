<h1>Edit Plan</h1>

<%= form_with model: [@user, @plan] do |form| %>
  <%= form.label :title %>
  <%= form.text_field :title %>

  <%= form.label :location %>
  <%= form.text_field :location %>

  <%= form.label :vibe %>
  <%= form.text_field :vibe %>

  <%= form.label :budget %>
  <%= form.number_field :budget, step: 0.01 %>

  <%= label_tag :notes, "Notes" %>
  <%= text_area_tag :notes %>

 <li><%= form.submit "Edit" %></li>
<% end %>