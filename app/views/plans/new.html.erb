<h1> Build your plan and discover three random activities </h1>
<%= form_with model: [@user, @plan] do |form| %>
  <%= form.label :title %>
  <%= form.text_field :title %>

  <%= form.label :location %>
  <%= form.text_field :location %>

  <%= form.label :vibe %>
  <%= form.select :vibe, Plan::VIBES %>

  <%= form.label :budget %>
  <%= form.number_field :budget, step: 0.01 %>

  <%= label_tag :notes, "Notes" %>
  <%= text_area_tag :notes %>

 <li><%= form.submit "Generate" %></li>
<% end %>
