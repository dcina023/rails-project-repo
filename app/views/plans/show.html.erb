<h1> View this plans details </h1>
<ul>
  <li>What's it called?: <%= @plan.title %></li>
  <li>Where's it at?: <%= @plan.location %></li>
  <li>What's the vibe?: <%= @plan.vibe %></li>
  <li>Will it break the bank?: <%= @plan.budget %></li>
</ul>

  <h2><%= @plan.title %></h2>

  <% @plan.plan_activities.includes(:activity).each do |plan_activity| %>
    <h3><%= plan_activity.activity.name %></h3>
    <p><%= plan_activity.activity.description %></p>
    <p>Notes: <%= plan_activity.notes %></p>
    <p>Rating: <%= plan_activity.rating %></p>
  <% end %>