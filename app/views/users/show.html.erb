<h1>Welcome "<%=@user.name%>" to Cina New-Scene!</h1>

<p>View your saved game plans</p>

<% @plans.each do |plan| %>
  <h3><%= link_to plan.title, user_plan_path(@user, plan) %></h3> 
  <%= link_to "Edit", edit_user_plan_path(@user, plan) %>

  <% plan.plan_activities.each do |plan_activity| %>
    <ul>
     <li>Activity: #<%= plan_activity.activity.name%></li>
     <li>Rating:  <%= plan_activity.rating %></li>
      <li>Notes:  <%= plan_activity.notes %></li>
    </ul>
  <% end %>
<% end %>
