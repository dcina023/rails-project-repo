<h1>Welcome "<%=@user.name%>" to Cina New-Scene!</h1>

<p>View your saved game plans</p>

<% @plans.each do |plan| %>
  <h3><%= link_to plan.title, user_plan_path(@user, plan) %></h3> 
  <%= link_to "Edit", edit_user_plan_path(@user, plan) %>
  <%= button_to "Delete", [@user, plan], 
              method: :delete, 
              form: { data: { turbo_confirm: "Are you sure?" } }, 
              class: "btn btn-danger" %>
<%end%>
